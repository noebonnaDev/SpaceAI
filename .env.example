# =====================================================================================
# Ritrovo - configurazione di PRODUZIONE
# Copia questo file in ".env" (stessa cartella di docker-compose.yml) e sostituisci i segnaposto <...>.
# Il file .env contiene segreti: non va mai inserito nel repository (è già escluso da .gitignore).
# Ogni valore indica da dove si ricava. Guida completa: docs/03-installazione.md
# =====================================================================================

# --- Generale ---------------------------------------------------------------------
NODE_ENV=production
# Indirizzo HTTPS con cui utenti, Outlook e Microsoft Graph raggiungono Ritrovo (senza "/" finale).
# Da dove: il nome DNS che hai scelto per Ritrovo (es. https://prenotazioni.azienda.it).
PUBLIC_BASE_URL=https://<nome-dns-di-ritrovo>
# Solo il nome host, usato da Caddy per il certificato HTTPS (es. prenotazioni.azienda.it).
RITROVO_DOMAIN=<nome-dns-di-ritrovo>

# --- Database ---------------------------------------------------------------------
# Scegli una password lunga e casuale (es. generata con: openssl rand -base64 32).
POSTGRES_PASSWORD=<password-database>

# --- Microsoft Entra ID e Microsoft Graph ---------------------------------------------
# entra = accesso con account Microsoft 365; live = chiamate reali a Microsoft Graph.
AUTH_MODE=entra
GRAPH_MODE=live
# Da dove: Microsoft Entra admin center > Entra ID > App registrations > Ritrovo > Overview > "Directory (tenant) ID".
ENTRA_TENANT_ID=<id-tenant>
# Da dove: Entra ID > App registrations > Ritrovo > Overview > "Application (client) ID".
ENTRA_CLIENT_ID=<id-applicazione>
# Credenziale del client riservato (usane UNA sola):
# a) certificato (consigliato): file nella cartella ./secrets del server, caricato in App registrations > Certificates & secrets.
ENTRA_CLIENT_CERT_PATH=/run/secrets/ritrovo/ritrovo-app.crt
ENTRA_CLIENT_KEY_PATH=/run/secrets/ritrovo/ritrovo-app.key
# b) in alternativa un client secret: Certificates & secrets > Client secrets > New client secret (copia il "Value").
# ENTRA_CLIENT_SECRET=<valore-del-segreto>

# Email (separate da virgola) di chi diventa amministratore al primo accesso.
INITIAL_ADMIN_EMAILS=<email-amministratore>

# --- Sincronizzazione con Outlook -------------------------------------------------------
# true solo se PUBLIC_BASE_URL è raggiungibile da Internet (Microsoft Graph invia le notifiche via HTTPS).
# Con false Ritrovo usa solo la sincronizzazione periodica (delta query).
GRAPH_WEBHOOKS_ENABLED=false
GRAPH_DELTA_INTERVAL_SECONDS=120

# --- Dati di esempio ---------------------------------------------------------------
# Sempre false in produzione (con GRAPH_MODE=live viene comunque ignorato).
SEED_DEMO_DATA=false

# --- Facoltativi --------------------------------------------------------------------
# GUID dell'add-in Outlook (lascia vuoto per usare quello predefinito).
# ADDIN_ID=
LOG_LEVEL=info
# Porta locale dell'app quando NON usi docker-compose.prod.yml.
# APP_PORT=8080
# APP_BIND=127.0.0.1
