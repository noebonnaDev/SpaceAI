<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ritrovo - Outlook add-in, "add-in only" XML manifest.
  Chosen over the unified JSON manifest because Microsoft documents that the unified manifest is not supported
  in Outlook on Mac and on mobile, while this add-in must run in new and classic Outlook for Windows, Mac, web and mobile.
  Generated by packages/addin/scripts/generate-manifest.mjs: do not edit manifest.xml by hand.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" xsi:type="MailApp">
  <Id>{{ADDIN_ID}}</Id>
  <Version>{{VERSION}}</Version>
  <ProviderName>{{PROVIDER}}</ProviderName>
  <DefaultLocale>it-IT</DefaultLocale>
  <DisplayName DefaultValue="{{DISPLAY_NAME}}"/>
  <Description DefaultValue="Prenota sale riunioni, postazioni e risorse condivise da Outlook, con check-in e regole dell'ufficio."/>
  <IconUrl DefaultValue="{{BASE_URL}}/addin/icons/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="{{BASE_URL}}/addin/icons/icon-128.png"/>
  <SupportUrl DefaultValue="{{SUPPORT_URL}}"/>
  <AppDomains>
    <AppDomain>{{BASE_URL}}</AppDomain>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="{{BASE_URL}}/addin/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Edit"/>
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="functionFile"/>
            <!-- Composing a meeting: suggest free rooms for the meeting's time and add one to the meeting. -->
            <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="ritrovoOrganizerGroup">
                  <Label resid="groupLabel"/>
                  <Control xsi:type="Button" id="ritrovoOrganizerButton">
                    <Label resid="organizerButtonLabel"/>
                    <Supertip>
                      <Title resid="organizerButtonLabel"/>
                      <Description resid="organizerButtonDescription"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16"/>
                      <bt:Image size="32" resid="icon32"/>
                      <bt:Image size="80" resid="icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="taskpaneUrl"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <!-- Reading a meeting: my bookings, check-in. -->
            <ExtensionPoint xsi:type="AppointmentAttendeeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="ritrovoAttendeeGroup">
                  <Label resid="groupLabel"/>
                  <Control xsi:type="Button" id="ritrovoAttendeeButton">
                    <Label resid="paneButtonLabel"/>
                    <Supertip>
                      <Title resid="paneButtonLabel"/>
                      <Description resid="paneButtonDescription"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16"/>
                      <bt:Image size="32" resid="icon32"/>
                      <bt:Image size="80" resid="icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="taskpaneUrl"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <!-- Reading a message: quick booking of rooms, desks and shared resources. -->
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="ritrovoMessageGroup">
                  <Label resid="groupLabel"/>
                  <Control xsi:type="Button" id="ritrovoMessageButton">
                    <Label resid="paneButtonLabel"/>
                    <Supertip>
                      <Title resid="paneButtonLabel"/>
                      <Description resid="paneButtonDescription"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16"/>
                      <bt:Image size="32" resid="icon32"/>
                      <bt:Image size="80" resid="icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="taskpaneUrl"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
          <!-- Outlook mobile (iOS/Android): only the message read surface is available to general add-ins. -->
          <MobileFormFactor>
            <FunctionFile resid="functionFile"/>
            <ExtensionPoint xsi:type="MobileMessageReadCommandSurface">
              <Group id="ritrovoMobileGroup">
                <Label resid="groupLabel"/>
                <Control xsi:type="MobileButton" id="ritrovoMobileButton">
                  <Label resid="paneButtonLabel"/>
                  <Icon xsi:type="bt:MobileIconList">
                    <bt:Image size="25" scale="1" resid="icon25"/>
                    <bt:Image size="25" scale="2" resid="icon25"/>
                    <bt:Image size="25" scale="3" resid="icon25"/>
                    <bt:Image size="32" scale="1" resid="icon32"/>
                    <bt:Image size="32" scale="2" resid="icon32"/>
                    <bt:Image size="32" scale="3" resid="icon32"/>
                    <bt:Image size="48" scale="1" resid="icon48"/>
                    <bt:Image size="48" scale="2" resid="icon48"/>
                    <bt:Image size="48" scale="3" resid="icon48"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl"/>
                  </Action>
                </Control>
              </Group>
            </ExtensionPoint>
          </MobileFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="icon16" DefaultValue="{{BASE_URL}}/addin/icons/icon-16.png"/>
          <bt:Image id="icon25" DefaultValue="{{BASE_URL}}/addin/icons/icon-25.png"/>
          <bt:Image id="icon32" DefaultValue="{{BASE_URL}}/addin/icons/icon-32.png"/>
          <bt:Image id="icon48" DefaultValue="{{BASE_URL}}/addin/icons/icon-48.png"/>
          <bt:Image id="icon80" DefaultValue="{{BASE_URL}}/addin/icons/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="functionFile" DefaultValue="{{BASE_URL}}/addin/commands.html"/>
          <bt:Url id="taskpaneUrl" DefaultValue="{{BASE_URL}}/addin/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="groupLabel" DefaultValue="{{DISPLAY_NAME}}"/>
          <bt:String id="organizerButtonLabel" DefaultValue="Prenota una sala"/>
          <bt:String id="paneButtonLabel" DefaultValue="Prenotazioni"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="organizerButtonDescription" DefaultValue="Mostra le sale libere per l'orario di questa riunione e aggiunge quella scelta alla riunione."/>
          <bt:String id="paneButtonDescription" DefaultValue="Prenota sale, postazioni e risorse condivise e gestisci le tue prenotazioni e i check-in."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
